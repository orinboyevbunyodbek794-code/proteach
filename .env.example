# ============================================================
#  Pro Teach — sozlamalar namunasi
#  Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring
# ============================================================

# development | production
NODE_ENV=production
PORT=3000
# Server faqat lokal ulanishlarni qabul qilsin (Nginx orqali). Nginx bo'lmasa: 0.0.0.0
HOST=127.0.0.1

# Saytning to'liq manzili (canonical, sitemap, Open Graph uchun), oxirida / yo'q
SITE_URL=https://proteach.uz

# Sessiya kaliti — kamida 32 belgi, tasodifiy. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Admin faolsizlikdan keyin necha soatda tizimdan chiqariladi
SESSION_MAX_AGE_HOURS=8
# Cookie "Secure" belgisi: auto (HTTPS bo'lsa yoqiladi) | true | false
COOKIE_SECURE=auto
# Proksi (Nginx) ishonchli manzili: loopback = shu serverdagi Nginx
TRUST_PROXY=loopback

# Birinchi ishga tushganda yaratiladigan administrator.
# Keyin parolni admin paneldan o'zgartiring (bu yerdagi qiymat qayta ishlatilmaydi).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Yuklash chegaralari (MB). Nginx'dagi client_max_body_size bundan katta bo'lsin!
MAX_VIDEO_MB=200
MAX_IMAGE_MB=8

# Telegram bildirishnoma (ixtiyoriy). Bo'sh qolsa — o'chiq, sayt odatdagidek ishlaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vaqt mintaqasi (admin paneldagi sanalar uchun)
APP_TIMEZONE=Asia/Tashkent

# Fayllar joylashuvi (ixtiyoriy, standart qiymatlar loyiha ichida)
# DB_FILE=data/proteach.db
# UPLOADS_DIR=uploads
